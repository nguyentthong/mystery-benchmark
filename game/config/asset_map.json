      {"contains": "rug",              "asset": "furniture/rugRectangle.glb",      "scale": 1.5},
      {"contains": "window ledge",     "asset": "furniture/wallWindow.glb",        "scale": 1.0},
      {"contains": "window",           "asset": "furniture/wallWindow.glb",        "scale": 1.0},
      {"contains": "scratched painting", "asset": "furniture/wallWindow.glb",      "scale": 1.0},
      {"contains": "painting",         "asset": "furniture/wallWindow.glb",        "scale": 1.0},
      {"contains": "frame",            "asset": "furniture/wallWindow.glb",        "scale": 1.0},
      {"contains": "table",            "asset": "furniture/tableCoffee.glb",       "scale": 1.0},
      {"contains": "chair",            "asset": "furniture/chair.glb",             "scale": 1.7},
      {"contains": "safe",             "asset": "furniture/cabinetTelevisionDoors.glb", "scale": 1.1},
      {"contains": "bouquet",          "asset": "furniture/pottedPlant.glb",       "scale": 1.0},
      {"contains": "flower",           "asset": "furniture/plantSmall1.glb",       "scale": 1.0},
      {"contains": "radio",            "asset": "furniture/radio.glb",             "scale": 1.0}
    ]
  }
}
