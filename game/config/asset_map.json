{
  "version": 3,
  "_doc": [
    "Maps logical entity kinds to .glb model paths under game/assets/kenney/.",
    "Each entry can be a bare string asset path, or an object {asset, scale}.",
    "scale is a uniform multiplier applied to the loaded mesh.",
    "default_scale on a category sets the fallback scale when an entry has no override.",
    "Substring matching, first match wins, so order matters."
  ],
  "asset_root": "res://assets/kenney/",
  "characters": {
    "default_scale": 1.4,
    "default":  "characters/character-male-a.glb",
    "by_role": {
      "suspect":  {"asset": "characters/character-male-a.glb",   "scale": 1.4},
      "innocent": {"asset": "characters/character-female-c.glb", "scale": 1.4},
      "witness":  {"asset": "characters/character-male-b.glb",   "scale": 1.4},
      "victim":   {"asset": "characters/character-female-b.glb", "scale": 1.4}
    }
  },
  "objects": {
    "default_scale": 2.0,
    "default": {"asset": "furniture/cardboardBoxClosed.glb", "scale": 2.0},
    "patterns": [
      {"contains": "cleaver",      "asset": "weapons/blaster-a.glb",          "scale": 4.0},
      {"contains": "knife",        "asset": "weapons/blaster-a.glb",          "scale": 4.0},
      {"contains": "letter opener","asset": "weapons/blaster-b.glb",          "scale": 4.0},
      {"contains": "shears",       "asset": "weapons/blaster-c.glb",          "scale": 4.0},
      {"contains": "revolver",     "asset": "weapons/blaster-d.glb",          "scale": 4.0},
      {"contains": "candlestick",  "asset": "furniture/lampSquareTable.glb",  "scale": 1.5},
      {"contains": "decanter",     "asset": "furniture/kitchenBlender.glb",   "scale": 1.5},
      {"contains": "vial",         "asset": "furniture/kitchenCoffeeMachine.glb","scale":1.2},
      {"contains": "poison",       "asset": "furniture/kitchenCoffeeMachine.glb","scale":1.2},
      {"contains": "poker",        "asset": "furniture/coatRack.glb",         "scale": 1.0},
      {"contains": "fireplace",    "asset": "furniture/coatRack.glb",         "scale": 1.5},
      {"contains": "mantel",       "asset": "furniture/coatRack.glb",         "scale": 1.5},
      {"contains": "iron",         "asset": "furniture/coatRack.glb",         "scale": 1.0},
      {"contains": "bookend",      "asset": "furniture/books.glb",            "scale": 2.5},
