{
  "version": 2,
  "_doc": [
    "Maps logical entity kinds to .glb model paths under game/assets/kenney/.",
    "Filenames target Kenney's Furniture Kit, Mini Characters, and Blaster Kit.",
    "If a path doesn't exist, room_builder.gd falls back to a colored cube/capsule.",
    "Substring matching on patterns -- 'kitchen cleaver' matches 'cleaver'.",
    "First match wins, so order matters. Edit freely."
  ],
  "asset_root": "res://assets/kenney/",
  "characters": {
    "default": "characters/character-male-a.glb",
    "by_role": {
      "suspect":  "characters/character-male-a.glb",
      "innocent": "characters/character-female-c.glb",
      "witness":  "characters/character-male-b.glb",
      "victim":   "characters/character-female-b.glb"
    }
  },
  "objects": {
    "default": "furniture/cardboardBoxClosed.glb",
    "patterns": [
      {"contains": "cleaver",      "asset": "weapons/blaster-a.glb"},
      {"contains": "knife",        "asset": "weapons/blaster-a.glb"},
      {"contains": "letter opener","asset": "weapons/blaster-b.glb"},
      {"contains": "shears",       "asset": "weapons/blaster-c.glb"},
      {"contains": "revolver",     "asset": "weapons/blaster-d.glb"},
      {"contains": "candlestick",  "asset": "furniture/lampSquareTable.glb"},
      {"contains": "decanter",     "asset": "furniture/kitchenBlender.glb"},
      {"contains": "vial",         "asset": "furniture/kitchenCoffeeMachine.glb"},
      {"contains": "poison",       "asset": "furniture/kitchenCoffeeMachine.glb"},
      {"contains": "poker",        "asset": "furniture/coatRack.glb"},
      {"contains": "fireplace",    "asset": "furniture/coatRack.glb"},
      {"contains": "iron",         "asset": "furniture/coatRack.glb"},
      {"contains": "bookend",      "asset": "furniture/books.glb"},
      {"contains": "rope",         "asset": "furniture/pillowLong.glb"},
      {"contains": "scarf",        "asset": "furniture/pillow.glb"},
      {"contains": "statuette",    "asset": "furniture/bear.glb"},
      {"contains": "boots",        "asset": "furniture/cardboardBoxClosed.glb"},
      {"contains": "envelope",     "asset": "furniture/books.glb"},
      {"contains": "letter",       "asset": "furniture/books.glb"},
      {"contains": "diary",        "asset": "furniture/books.glb"},
      {"contains": "chess",        "asset": "furniture/books.glb"},
      {"contains": "receipt",      "asset": "furniture/books.glb"},
      {"contains": "ticket",       "asset": "furniture/books.glb"},
      {"contains": "fingerprint",  "asset": "furniture/laptop.glb"},
      {"contains": "umbrella",     "asset": "furniture/coatRack.glb"},
      {"contains": "watch",        "asset": "furniture/computerMouse.glb"},
      {"contains": "key",          "asset": "furniture/computerMouse.glb"},
      {"contains": "spectacles",   "asset": "characters/aid-glasses.glb"},
      {"contains": "glass",        "asset": "furniture/kitchenBlender.glb"},
      {"contains": "ink",          "asset": "furniture/kitchenBlender.glb"},
      {"contains": "glove",        "asset": "furniture/pillow.glb"},
      {"contains": "cigar",        "asset": "furniture/lampSquareTable.glb"},
      {"contains": "tray",         "asset": "furniture/tableCoffee.glb"},
      {"contains": "basket",       "asset": "furniture/cardboardBoxOpen.glb"},
      {"contains": "mirror",       "asset": "furniture/bathroomMirror.glb"},
      {"contains": "frame",        "asset": "furniture/wallWindow.glb"},
      {"contains": "painting",     "asset": "furniture/wallWindow.glb"},
      {"contains": "chair",        "asset": "furniture/chair.glb"},
      {"contains": "safe",         "asset": "furniture/cabinetTelevisionDoors.glb"},
      {"contains": "bouquet",      "asset": "furniture/pottedPlant.glb"},
      {"contains": "flower",       "asset": "furniture/plantSmall1.glb"},
      {"contains": "radiator",     "asset": "furniture/dryer.glb"},
      {"contains": "radio",        "asset": "furniture/radio.glb"}
    ]
  }
}
